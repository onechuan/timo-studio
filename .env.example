DATABASE_URL=postgresql://timotv:timotv@127.0.0.1:55439/timotv?schema=public
REDIS_URL=redis://127.0.0.1:56379
PORT=3001
STORAGE_ROOT=.data/assets

# Controlled rollout: video pipeline override. Use "drawing-engine-v3" for the
# Film Kit, page review, and whole-film review pipeline, or "legacy-v3".
# The persisted website setting remains the default when this override is omitted.
TIMOTV_VIDEO_PIPELINE=

# Director model; copied to server environment only. Never use VITE_ prefixes for secrets.
TIMO_PROVIDER=deepseek
TIMO_MODEL=deepseek-flash
TIMO_API_KEY=
# Compatible endpoints: exact API root, for example a /v1 root for OpenAI-compatible services.
TIMO_BASE_URL=https://api.deepseek.com
TIMO_PROTOCOL=openai

# Local macOS speech works without a paid key. Optional ElevenLabs:
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Set when Chrome isn't found automatically:
CHROME_PATH=

# Default voice provider: Volcengine / Doubao TTS 2.0.
VOLCENGINE_TTS_API_KEY=
# Optional: otherwise use 渊博小叔
VOLCENGINE_TTS_VOICE_ID=zh_male_yuanboxiaoshu_uranus_bigtts
# Optional explicit resource; inferred from voice when empty.
VOLCENGINE_TTS_RESOURCE_ID=
# Legacy console authentication (instead of API Key):
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
