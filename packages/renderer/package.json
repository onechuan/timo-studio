{
  "name": "@timotv/renderer",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@timotv/contracts": "workspace:*",
    "@timotv/core": "workspace:*",
    "@timotv/drawing-engine": "workspace:*",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.65.0"
  }
}
