{
  "name": "@timotv/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --tsconfig ../../tsconfig.dev.json --exclude '../../packages/**/dist/**' src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@timotv/agent": "workspace:*",
    "@timotv/contracts": "workspace:*",
    "@timotv/core": "workspace:*",
    "@timotv/db": "workspace:*",
    "@timotv/queue": "workspace:*",
    "@timotv/renderer": "workspace:*",
    "@timotv/speech": "workspace:*",
    "@timotv/storage": "workspace:*",
    "dotenv": "^17.2.3",
    "hono": "^4.10.0",
    "zod": "^3.25.76"
  }
}
