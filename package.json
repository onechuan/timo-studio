{
  "name": "timotv",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n api,worker,web \"pnpm --filter @timotv/api dev\" \"pnpm --filter @timotv/worker dev\" \"pnpm --filter @timotv/web dev\"",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm build:packages && vitest run",
    "engine:audit": "node scripts/sync-frametell-engine.mjs --check",
    "engine:sync": "node scripts/sync-frametell-engine.mjs --apply",
    "test:integration": "pnpm build:packages && RUN_INTEGRATION=1 vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @timotv/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @timotv/db migrate",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "postinstall": "pnpm db:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
